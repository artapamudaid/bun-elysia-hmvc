<%
    function asDateOnly(value) {
        return typeof value === 'string'
            ? value.slice(0, 10)
            : `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
    }
    function formatDate(value) {
        const [year, month, day] = asDateOnly(value).split('-').map(Number);
        return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('id-ID', {
            day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC'
        });
    }
    function jobState(job) {
        if (!Boolean(job.is_active) || asDateOnly(job.end_date) < overview.asOf) return ['secondary', 'Inactive'];
        if (asDateOnly(job.start_date) > overview.asOf) return ['info', 'Terjadwal'];
        return ['success', 'Dibuka'];
    }
    const maxDivisionJobs = Math.max(1, ...overview.jobsByDivision.map((item) => item.total));
    const todayLabel = formatDate(overview.asOf);
%>

<% if (query.status === 'login_success') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Berhasil masuk. Berikut ringkasan rekrutmen terbaru.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
<% } %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Dashboard Rekrutmen</h1>
        <p class="page-subtitle mb-0">Halo, <strong><%= currentUser?.name || currentUser?.email || 'Pengguna' %></strong>. Ringkasan operasional per <%= todayLabel %>.</p>
    </div>
    <a href="/jobs" class="btn btn-primary d-inline-flex align-items-center gap-2"><i class="bi bi-briefcase"></i> Kelola lowongan</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-start">
            <div><div class="small text-secondary mb-2">Total lowongan</div><div class="fs-3 fw-bold"><%= overview.metrics.totalJobs %></div><a href="/jobs" class="small text-decoration-none">Lihat daftar <i class="bi bi-arrow-right"></i></a></div>
            <span class="rounded-3 p-3 bg-primary-subtle text-primary"><i class="bi bi-briefcase fs-5"></i></span>
        </div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-start">
            <div><div class="small text-secondary mb-2">Sedang dibuka</div><div class="fs-3 fw-bold"><%= overview.metrics.openNow %></div><div class="small text-secondary">Tanggal hari ini berada dalam periode</div></div>
            <span class="rounded-3 p-3 bg-success-subtle text-success"><i class="bi bi-megaphone fs-5"></i></span>
        </div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-start">
            <div><div class="small text-secondary mb-2">Lowongan terjadwal</div><div class="fs-3 fw-bold"><%= overview.metrics.scheduled %></div><div class="small text-secondary">Aktif, tanggal mulai belum tiba</div></div>
            <span class="rounded-3 p-3 bg-info-subtle text-info"><i class="bi bi-calendar-event fs-5"></i></span>
        </div></div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100"><div class="card-body d-flex justify-content-between align-items-start">
            <div><div class="small text-secondary mb-2">Divisi</div><div class="fs-3 fw-bold"><%= overview.metrics.totalDivisions %></div><a href="/divisions" class="small text-decoration-none">Kelola divisi <i class="bi bi-arrow-right"></i></a></div>
            <span class="rounded-3 p-3 bg-warning-subtle text-warning"><i class="bi bi-diagram-3 fs-5"></i></span>
        </div></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-xl-7">
        <section class="card h-100 overflow-hidden">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-3">
                <div><h2 class="h6 fw-bold mb-1">Lowongan per divisi</h2><div class="small text-secondary">Jumlah lowongan tersimpan pada setiap divisi.</div></div>
                <a href="/divisions" class="btn btn-sm btn-outline-secondary">Kelola</a>
            </div>
            <div class="card-body">
                <% if (overview.jobsByDivision.length === 0) { %>
                    <div class="text-center text-secondary py-4"><i class="bi bi-diagram-3 fs-2 d-block mb-2"></i>Belum ada divisi. <a href="/divisions">Tambah divisi</a> untuk mulai.</div>
                <% } else { %>
                    <% overview.jobsByDivision.forEach((division) => { %>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1"><span class="fw-semibold"><%= division.name %></span><span class="text-secondary"><%= division.total %> lowongan</span></div>
                            <div class="progress" role="progressbar" aria-label="<%= division.name %>" aria-valuenow="<%= division.total %>" aria-valuemin="0" aria-valuemax="<%= maxDivisionJobs %>" style="height:8px"><div class="progress-bar" style="width:<%= Math.round(division.total / maxDivisionJobs * 100) %>%"></div></div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-5">
        <section class="card h-100 overflow-hidden">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-3">
                <div><h2 class="h6 fw-bold mb-1">Segera berakhir</h2><div class="small text-secondary">Lowongan aktif yang berakhir dalam 7 hari.</div></div>
                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"><%= overview.expiringSoon.length %></span>
            </div>
            <% if (!overview.expiringSoon.length) { %>
                <div class="card-body text-center text-secondary py-4"><i class="bi bi-check2-circle fs-2 d-block mb-2"></i>Tidak ada lowongan yang berakhir dalam 7 hari.</div>
            <% } else { %>
                <div class="list-group list-group-flush">
                    <% overview.expiringSoon.forEach((job) => { %>
                        <div class="list-group-item px-3 py-3 d-flex justify-content-between gap-3">
                            <div class="min-w-0"><div class="fw-semibold text-truncate"><%= job.title %></div><div class="small text-secondary"><%= job.division %></div></div>
                            <div class="small text-nowrap text-end"><span class="d-block text-secondary">Berakhir</span><strong><%= formatDate(job.end_date) %></strong></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section class="card overflow-hidden">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-3">
                <div><h2 class="h6 fw-bold mb-1">Lowongan terbaru</h2><div class="small text-secondary">5 lowongan terakhir berdasarkan waktu dibuat.</div></div>
                <a href="/jobs" class="btn btn-sm btn-outline-secondary">Semua lowongan</a>
            </div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead><tr class="small text-uppercase text-secondary"><th class="ps-3">Posisi</th><th>Divisi</th><th>Periode</th><th>Status</th></tr></thead>
                <tbody>
                    <% if (!overview.recentJobs.length) { %><tr><td colspan="4" class="text-center py-4 text-secondary">Belum ada data lowongan.</td></tr><% } %>
                    <% overview.recentJobs.forEach((job) => { const state = jobState(job); %>
                        <tr><td class="ps-3"><div class="fw-semibold"><%= job.title %></div><code class="small"><%= job.slug %></code></td><td><%= job.division %></td><td class="text-nowrap small"><%= formatDate(job.start_date) %> – <%= formatDate(job.end_date) %></td><td><span class="badge rounded-pill bg-<%= state[0] %>"><%= state[1] %></span></td></tr>
                    <% }) %>
                </tbody>
            </table></div>
        </section>
    </div>
    <div class="col-12 col-xl-5">
        <section class="card overflow-hidden h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-3">
                <div><h2 class="h6 fw-bold mb-1">Pengguna terbaru</h2><div class="small text-secondary">Akun yang terakhir ditambahkan.</div></div>
                <div class="text-end"><div class="fw-bold"><%= overview.metrics.totalUsers %></div><div class="small text-secondary">total akun</div></div>
            </div>
            <div class="list-group list-group-flush">
                <% if (!overview.recentUsers.length) { %><div class="list-group-item text-center py-4 text-secondary">Belum ada akun pengguna.</div><% } %>
                <% overview.recentUsers.forEach((user) => { %>
                    <div class="list-group-item px-3 py-3 d-flex align-items-center gap-3">
                        <span class="rounded-circle bg-light text-secondary d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px"><i class="bi bi-person"></i></span>
                        <div class="min-w-0"><div class="fw-semibold text-truncate"><%= user.name %></div><div class="small text-secondary text-truncate"><%= user.email %></div></div>
                    </div>
                <% }) %>
            </div>
            <div class="card-footer bg-transparent"><a href="/users" class="small text-decoration-none">Kelola pengguna <i class="bi bi-arrow-right"></i></a></div>
        </section>
    </div>
</div>
