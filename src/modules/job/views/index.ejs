<%
    const statusMessages = {
        created: 'Lowongan berhasil dibuat.',
        updated: 'Lowongan berhasil diperbarui.',
        deleted: 'Lowongan berhasil dihapus.',
        invalid: 'Data lowongan tidak valid.',
        not_found: 'Lowongan tidak ditemukan.',
    };
    function formatJobDate(value) {
        const dateOnly = typeof value === 'string'
            ? value.slice(0, 10)
            : `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
        const [year, month, day] = dateOnly.split('-').map(Number);
        return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('id-ID', {
            day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC'
        });
    }
    function buildUrl(newPage, newSort, newOrder, newPerPage, newSearch) {
        const params = new URLSearchParams();
        const page = newPage ?? datatable.page;
        const sort = newSort ?? datatable.sort;
        const order = newOrder ?? datatable.order;
        const perPage = newPerPage ?? datatable.perPage;
        const search = newSearch !== undefined ? newSearch : filters.search;
        if (page > 1) params.set('page', page);
        if (perPage !== 10) params.set('per_page', perPage);
        if (search) params.set('search', search);
        if (filters.division) params.set('division', filters.division);
        if (filters.status) params.set('status', filters.status);
        if (filters.date_from) params.set('date_from', filters.date_from);
        if (filters.date_to) params.set('date_to', filters.date_to);
        if (sort !== 'j.created_at') params.set('sort', sort === 'd.name' ? 'division' : sort.replace(/^j\./, ''));
        if (order !== 'desc') params.set('order', order);
        const queryString = params.toString();
        return '/jobs' + (queryString ? `?${queryString}` : '');
    }
    function sortUrl(column) {
        const sortColumns = { id: 'j.id', title: 'j.title', division: 'd.name', start_date: 'j.start_date', is_active: 'j.is_active' };
        const resolvedColumn = sortColumns[column] ?? column;
        const nextOrder = datatable.sort === resolvedColumn && datatable.order === 'asc' ? 'desc' : 'asc';
        return buildUrl(1, resolvedColumn, nextOrder);
    }
    function sortIcon(column) {
        if (datatable.sort !== column) return 'bi-arrow-down-up text-muted opacity-50';
        return datatable.order === 'asc' ? 'bi-sort-alpha-down text-primary' : 'bi-sort-alpha-down-alt text-primary';
    }
    const sortParameter = datatable.sort === 'd.name' ? 'division' : datatable.sort.replace(/^j\./, '');
    const currentReturnUrl = buildUrl();
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="page-title mb-1">Lowongan Kerja</h2>
        <p class="page-subtitle">Kelola posisi, divisi, dan periode rekrutmen.</p>
    </div>
    <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2" data-bs-toggle="modal" data-bs-target="#jobCreateModal">
        <i class="bi bi-plus-lg"></i> Buat Lowongan
    </button>
</div>

<% if (query.notice && statusMessages[query.notice]) { %>
    <div class="alert <%= ['created', 'updated', 'deleted'].includes(query.notice) ? 'alert-success' : 'alert-warning' %> alert-dismissible fade show" role="alert">
        <%= statusMessages[query.notice] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
<% } %>

<div class="card overflow-hidden mb-4">
    <div class="card-header p-3">
        <form action="/jobs" method="GET" class="row g-3 align-items-end">
            <input type="hidden" name="sort" value="<%= sortParameter %>">
            <input type="hidden" name="order" value="<%= datatable.order %>">
            <div class="col-12 col-sm-auto d-flex align-items-center gap-2">
                <label class="form-label small mb-0 text-nowrap" for="per_page">Tampilkan:</label>
                <select class="form-select form-select-sm w-auto" id="per_page" name="per_page" onchange="this.form.submit()">
                    <% [5, 10, 25, 50].forEach((count) => { %>
                        <option value="<%= count %>" <%= datatable.perPage === count ? 'selected' : '' %>><%= count %></option>
                    <% }) %>
                </select>
                <span class="small text-secondary">entri</span>
            </div>
            <div class="col-12 col-lg-3">
                <label class="form-label small" for="filter-search">Cari lowongan</label>
                <div class="input-group">
                    <input class="form-control" id="filter-search" name="search" value="<%= filters.search %>" placeholder="Judul, slug, atau divisi">
                    <button class="btn btn-primary" type="submit">Cari</button>
                    <% if (filters.search) { %>
                        <a class="btn btn-outline-secondary" href="<%= buildUrl(1, undefined, undefined, undefined, '') %>" title="Hapus pencarian"><i class="bi bi-x-lg"></i></a>
                    <% } %>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small" for="filter-division">Divisi</label>
                <select class="form-select" id="filter-division" name="division">
                    <option value="">Semua divisi</option>
                    <% divisions.forEach((division) => { %>
                        <option value="<%= division.id %>" <%= filters.division === String(division.id) ? 'selected' : '' %>><%= division.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small" for="filter-status">Status</label>
                <select class="form-select" id="filter-status" name="status">
                    <option value="">Semua status</option>
                    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="filter-date-from">Periode dari</label>
                <input class="form-control" type="date" id="filter-date-from" name="date_from" value="<%= filters.date_from %>">
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small" for="filter-date-to">Periode sampai</label>
                <input class="form-control" type="date" id="filter-date-to" name="date_to" value="<%= filters.date_to %>">
            </div>
            <div class="col-12 col-lg-auto d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Terapkan</button>
                <a class="btn btn-outline-secondary" href="/jobs" aria-label="Reset filter"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card-header p-3 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="h6 fw-bold mb-1">Daftar Lowongan</h3>
            <span class="small text-secondary"><%= datatable.recordsFiltered %> lowongan ditemukan</span>
        </div>
        <i class="bi bi-briefcase text-secondary"></i>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead>
                <tr class="small text-uppercase text-secondary">
                    <th scope="col" class="text-center" style="width:60px"><a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="<%= sortUrl('id') %>">No <i class="bi <%= datatable.sort === 'j.id' ? (datatable.order === 'asc' ? 'bi-sort-numeric-down text-primary' : 'bi-sort-numeric-down-alt text-primary') : 'bi-arrow-down-up text-muted opacity-50' %>"></i></a></th>
                    <th scope="col" class="ps-3"><a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="<%= sortUrl('title') %>">Posisi <i class="bi <%= sortIcon('j.title') %>"></i></a></th>
                    <th scope="col"><a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="<%= sortUrl('division') %>">Divisi <i class="bi <%= sortIcon('d.name') %>"></i></a></th>
                    <th scope="col"><a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="<%= sortUrl('start_date') %>">Periode rekrutmen <i class="bi <%= sortIcon('j.start_date') %>"></i></a></th>
                    <th scope="col"><a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1" href="<%= sortUrl('is_active') %>">Status <i class="bi <%= sortIcon('j.is_active') %>"></i></a></th>
                    <th scope="col" class="text-end pe-3" style="width:110px">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (datatable.data.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-5 text-secondary"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Tidak ada lowongan sesuai filter.</td></tr>
                <% } else { %>
                    <% datatable.data.forEach((job, index) => { %>
                        <tr>
                            <td class="text-secondary fw-semibold text-center"><%= datatable.from + index %></td>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-3">
                                    <% if (job.image_path) { %>
                                        <img src="<%= job.image_path %>" alt="" width="44" height="44" class="rounded-3" style="object-fit:cover">
                                    <% } else { %>
                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-light text-secondary" style="width:44px;height:44px"><i class="bi bi-briefcase"></i></div>
                                    <% } %>
                                    <div><div class="fw-bold"><%= job.title %></div><code class="small"><%= job.slug %></code></div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-secondary border"><%= job.division %></span></td>
                            <td class="text-nowrap"><i class="bi bi-calendar3 text-secondary me-1"></i><%= formatJobDate(job.start_date) %> – <%= formatJobDate(job.end_date) %></td>
                            <td><span class="badge rounded-pill <%= job.is_active ? 'bg-success' : 'bg-secondary' %>"><%= job.is_active ? 'Active' : 'Inactive' %></span></td>
                            <td class="text-end pe-3 text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#jobEditModal-<%= job.id %>" aria-label="Edit <%= job.title %>"><i class="bi bi-pencil"></i></button>
                                <form action="/jobs/delete/<%= job.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus lowongan ini?')">
                                    <% if (csrfToken) { %><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><% } %>
                                    <input type="hidden" name="return_url" value="<%= currentReturnUrl %>">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Hapus <%= job.title %>"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
    <div class="card-footer p-3">
        <div class="row align-items-center gy-3">
            <div class="col-12 col-md-6 text-center text-md-start small text-secondary">
                <% if (datatable.recordsFiltered > 0) { %>
                    Menampilkan <strong><%= datatable.from %></strong>–<strong><%= datatable.to %></strong> dari <strong><%= datatable.recordsFiltered %></strong> lowongan
                    <% if (datatable.recordsFiltered !== datatable.recordsTotal) { %><span class="text-muted">(dari <%= datatable.recordsTotal %> hasil filter)</span><% } %>
                <% } else { %>Menampilkan 0 lowongan<% } %>
            </div>
            <div class="col-12 col-md-6">
                <nav aria-label="Navigasi halaman lowongan">
                    <ul class="pagination pagination-sm justify-content-center justify-content-md-end mb-0">
                        <li class="page-item <%= datatable.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= buildUrl(1) %>" aria-label="Awal"><i class="bi bi-chevron-double-left"></i></a></li>
                        <li class="page-item <%= !datatable.hasPrev ? 'disabled' : '' %>"><a class="page-link" href="<%= buildUrl(datatable.page - 1) %>" aria-label="Sebelumnya"><i class="bi bi-chevron-left"></i></a></li>
                        <%
                            const maxVisiblePages = 5;
                            let startPage = Math.max(1, datatable.page - Math.floor(maxVisiblePages / 2));
                            let endPage = Math.min(datatable.lastPage, startPage + maxVisiblePages - 1);
                            if (endPage - startPage + 1 < maxVisiblePages) startPage = Math.max(1, endPage - maxVisiblePages + 1);
                        %>
                        <% for (let page = startPage; page <= endPage; page++) { %>
                            <li class="page-item <%= page === datatable.page ? 'active' : '' %>"><a class="page-link" href="<%= buildUrl(page) %>"><%= page %></a></li>
                        <% } %>
                        <li class="page-item <%= !datatable.hasNext ? 'disabled' : '' %>"><a class="page-link" href="<%= buildUrl(datatable.page + 1) %>" aria-label="Berikutnya"><i class="bi bi-chevron-right"></i></a></li>
                        <li class="page-item <%= datatable.page >= datatable.lastPage ? 'disabled' : '' %>"><a class="page-link" href="<%= buildUrl(datatable.lastPage) %>" aria-label="Akhir"><i class="bi bi-chevron-double-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<% jobs.forEach((job) => { %>
    <div class="modal fade job-modal" id="jobEditModal-<%= job.id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <form action="/jobs/update/<%= job.id %>" method="POST" enctype="multipart/form-data">
                <% if (csrfToken) { %><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><% } %>
                <input type="hidden" name="return_url" value="<%= currentReturnUrl %>">
                <div class="modal-header"><h2 class="modal-title h5">Edit Lowongan</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
                <div class="modal-body"><%- include('form-fields', { job, divisions }) %></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button><button type="submit" class="btn btn-primary">Simpan Perubahan</button></div>
            </form>
        </div></div>
    </div>
<% }) %>

<div class="modal fade job-modal" id="jobCreateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <form action="/jobs" method="POST" enctype="multipart/form-data">
            <% if (csrfToken) { %><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><% } %>
            <input type="hidden" name="return_url" value="<%= currentReturnUrl %>">
            <div class="modal-header"><h2 class="modal-title h5">Buat Lowongan</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
            <div class="modal-body"><%- include('form-fields', { job: null, divisions }) %></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button><button type="submit" class="btn btn-primary">Terbitkan Lowongan</button></div>
        </form>
    </div></div>
</div>

<style>
    .job-modal .modal-dialog { height: calc(100% - 2rem); }
    .job-modal .modal-content { max-height: calc(100vh - 2rem); overflow: hidden; }
    .job-modal .modal-content > form { min-height: 0; display: flex; flex: 1 1 auto; flex-direction: column; overflow: hidden; }
    .job-modal .modal-header, .job-modal .modal-footer { flex: 0 0 auto; }
    .job-modal .modal-body { min-height: 0; overflow-y: auto; }
</style>
