<div class="login-bg-shape login-bg-shape-1"></div>
<div class="login-bg-shape login-bg-shape-2"></div>
<section class="login-card-wrapper">
    <div class="login-card">
        <a href="/users" class="login-brand"><i class="bi bi-asterisk"></i><span>Bun Elysia</span></a>
        <h1 class="login-title">Masuk ke Akun</h1>
        <p class="login-subtitle">Bun Elysia HMVC Authentication &amp; Session</p>

        <% if (query?.error === 'invalid_credentials') { %>
            <div class="login-error" role="alert">Alamat email atau kata sandi yang Anda masukkan salah.</div>
        <% } else if (query?.error === 'empty_fields') { %>
            <div class="login-error" role="alert">Silakan isi alamat email dan kata sandi Anda.</div>
        <% } %>

        <form action="/auth/login" method="POST" id="formLogin">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <% } %>
            <div class="login-form-group">
                <label for="email" class="login-form-label">Alamat Email</label>
                <div class="login-input-group">
                    <i class="bi bi-envelope input-icon"></i>
                    <input type="email" id="email" name="email" class="login-input" value="admin@example.com" placeholder="nama@example.com" required autofocus>
                </div>
            </div>
            <div class="login-form-group">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label for="password" class="login-form-label mb-0">Kata Sandi</label>
                    <span class="text-muted small">Demo: password123</span>
                </div>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input type="password" id="password" name="password" class="login-input login-input-password" value="password123" placeholder="Masukkan kata sandi" required>
                    <button type="button" class="password-toggle-btn" id="togglePassword" aria-label="Tampilkan kata sandi"><i class="bi bi-eye" id="toggleIcon"></i></button>
                </div>
            </div>
            <div class="small text-secondary mb-4">
                <div><strong>Admin:</strong> admin@example.com</div>
                <div><strong>User:</strong> budi@example.com</div>
            </div>
            <button type="submit" class="btn-login"><span>Masuk ke Dashboard</span><i class="bi bi-arrow-right"></i></button>
        </form>
        <p class="login-footer-text mt-4"><a href="/users">Lihat modul pengguna</a></p>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('toggleIcon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function () {
                const showPassword = passwordInput.type === 'password';
                passwordInput.type = showPassword ? 'text' : 'password';
                toggleIcon.className = showPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        }

        const status = new URLSearchParams(window.location.search).get('status');
        if (status === 'logged_out' && typeof Swal !== 'undefined') {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Anda berhasil keluar.', showConfirmButton: false, timer: 3000, background: '#fff', color: '#0B130F' });
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>
