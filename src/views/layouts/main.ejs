<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Bun Elysia HMVC' %> | Spark Admin</title>
    <link rel="icon" href="/public/spark-admin/assets/images/favicon.ico">
    <link rel="stylesheet" href="/public/spark-admin/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/public/spark-admin/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/public/spark-admin/assets/css/main.css">
    <style>
        .main-wrapper { min-height: 100vh; }
        .main-wrapper > .navbar-custom { grid-template-columns: 1fr auto !important; }
        .main-wrapper > .spark-content { padding: 0; flex: 1; }
        .navbar-page-label { font-weight: 700; }
        .spark-content .text-light { color: var(--text-main) !important; }
        .spark-content .text-info { color: var(--brand-forest-medium) !important; }
        .spark-content .bg-dark { background-color: #f4f6f5 !important; }
        .spark-content .bg-black { background-color: #fff !important; }
        .spark-content .border-secondary { border-color: var(--border-light) !important; }
        .spark-content .table-dark { --bs-table-bg: #fff; --bs-table-color: var(--text-main); --bs-table-striped-bg: #f7f9f8; --bs-table-hover-bg: #f1f5f3; --bs-table-border-color: var(--border-light); }
        .spark-content .form-control.bg-black, .spark-content .form-control.bg-dark, .spark-content .form-select.bg-dark { background-color: #fff !important; color: var(--text-main) !important; }
        .sidebar-profile-img, .navbar-profile-img { object-fit: cover; }
        .navbar-profile-img { width: 36px; height: 36px; border-radius: 50%; }
        .login-card-wrapper { width: 100%; max-width: 450px; }
        .login-card-wrapper .login-card { padding: 2rem; }
        .login-card-wrapper .login-form-group { margin-bottom: 1.25rem; }
        .login-card-wrapper .login-input-group .input-icon { position: absolute; left: 1rem; z-index: 2; }
        .login-card-wrapper .login-input { padding-left: 2.8rem; }
        .login-card-wrapper .login-input-password { padding-right: 2.8rem; }
        .login-card-wrapper .password-toggle-btn { position: absolute; right: 1rem; z-index: 3; }
        .login-card-wrapper .login-error { background: #fee2e2; color: #991b1b; border-radius: 10px; padding: .75rem 1rem; margin-bottom: 1rem; font-size: .875rem; }
        @media (max-width: 575.98px) { .login-card-wrapper .login-card { padding: 1.5rem; } }
    </style>
</head>
<body>
<% const isLoginPage = typeof pageType !== 'undefined' && pageType === 'login'; %>
<% if (isLoginPage) { %>
    <main class="login-wrapper">
        <%- body %>
    </main>
<% } else { %>
    <aside class="sidebar-wrapper" id="sidebar">
        <a href="/dashboard" class="sidebar-brand"><i class="bi bi-asterisk"></i><span>Bun Elysia</span></a>
        <div class="flex-grow-1 overflow-y-auto">
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Menu</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item"><a href="/dashboard" class="sidebar-menu-link <%= activeNav === 'dashboard' ? 'active' : '' %>"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a></li>
                </ul>
            </div>
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Manajemen</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item"><a href="/jobs" class="sidebar-menu-link <%= activeNav === 'jobs' ? 'active' : '' %>"><i class="bi bi-briefcase"></i><span>Lowongan</span></a></li>
                    <li class="sidebar-menu-item"><a href="/divisions" class="sidebar-menu-link <%= activeNav === 'divisions' ? 'active' : '' %>"><i class="bi bi-diagram-3"></i><span>Divisi</span></a></li>
                    <li class="sidebar-menu-item"><a href="/users" class="sidebar-menu-link <%= activeNav === 'users' ? 'active' : '' %>"><i class="bi bi-people"></i><span>Pengguna</span></a></li>
                    <li class="sidebar-menu-item"><a href="/auth/sessions" class="sidebar-menu-link <%= activeNav === 'sessions' ? 'active' : '' %>"><i class="bi bi-hdd-network"></i><span>Sesi Aktif</span></a></li>
                </ul>
            </div>
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Akun</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item"><a href="<%= currentUser ? '/auth/logout' : '/auth/login' %>" class="sidebar-menu-link"><i class="bi bi-box-arrow-<%= currentUser ? 'right' : 'in-right' %>"></i><span><%= currentUser ? 'Keluar' : 'Masuk' %></span></a></li>
                </ul>
            </div>
        </div>
        <div class="sidebar-profile">
            <img src="/public/spark-admin/assets/images/avatar.png" alt="Profil" class="sidebar-profile-img">
            <div class="sidebar-profile-info"><div class="sidebar-profile-name"><%= currentUser ? (currentUser.name || currentUser.email) : 'Pengunjung' %></div><div class="sidebar-profile-email"><%= currentUser ? currentUser.email : 'Belum masuk' %></div></div>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="navbar-custom">
            <div class="navbar-left">
                <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Buka navigasi"><i class="bi bi-list"></i></button>
                <div class="navbar-page-label d-none d-sm-block"><%= activeNav === 'sessions' ? 'Manajemen Sesi' : activeNav === 'jobs' ? 'Rekrutmen' : activeNav === 'divisions' ? 'Manajemen Divisi' : activeNav === 'dashboard' ? 'Dashboard' : 'Manajemen Pengguna' %></div>
            </div>
            <div class="navbar-actions">
                <% if (currentUser) { %>
                    <div class="dropdown">
                        <button class="navbar-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="/public/spark-admin/assets/images/avatar.png" alt="Profil" class="navbar-profile-img">
                            <span class="navbar-profile-name d-none d-md-inline"><%= currentUser.name || currentUser.email %></span>
                            <i class="bi bi-chevron-down navbar-profile-caret"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile">
                            <li class="dropdown-header"><%= currentUser.email %></li>
                            <li><a class="dropdown-item" href="/auth/sessions"><i class="bi bi-hdd-network"></i> Sesi aktif</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Keluar</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a class="btn btn-sm btn-primary" href="/auth/login">Masuk</a>
                <% } %>
            </div>
        </header>
        <main class="spark-content">
            <%- body %>
        </main>
        <footer class="footer-custom"><div class="footer-left"><span class="footer-logo"><i class="bi bi-asterisk"></i> Bun Elysia HMVC</span><span class="footer-separator">|</span><span class="footer-copy">Admin dashboard powered by Spark Admin</span></div></footer>
    </div>
<% } %>
<script src="/public/spark-admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/public/spark-admin/assets/js/dashboard.js"></script>
</body>
</html>
