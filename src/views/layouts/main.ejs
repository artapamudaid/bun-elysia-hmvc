<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Bun Elysia HMVC' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- SweetAlert2 Dark Theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-dark@5/dark.css">
    <style>
        body {
            background-color: #0b0f19;
            color: #e2e8f0;
            min-height: 100vh;
        }
        .navbar-custom {
            background-color: #111827;
            border-bottom: 1px solid #1f2937;
        }
        .footer-custom {
            border-top: 1px solid #1f2937;
            background-color: #111827;
            color: #64748b;
        }
    </style>
</head>
<body class="d-flex flex-column">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="/">
                ⚡ Bun Elysia <span class="badge bg-secondary text-uppercase ms-1" style="font-size: 0.65rem;">HMVC</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/users">
                            <i class="bi bi-people me-1"></i> Users Module
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/auth/sessions">
                            <i class="bi bi-hdd-network me-1"></i> Sessions Table
                        </a>
                    </li>
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <li class="nav-item dropdown ms-lg-2">
                            <a class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle text-primary"></i> <%= currentUser.name || currentUser.email %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow">
                                <li><h6 class="dropdown-header text-muted small"><%= currentUser.email %> (<%= currentUser.role || 'user' %>)</h6></li>
                                <li><a class="dropdown-item small" href="/auth/sessions"><i class="bi bi-hdd-network me-2"></i> Kelola Sesi Aktif</a></li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li><a class="dropdown-item text-danger small" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Keluar (Logout)</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-sm btn-primary px-3 shadow-sm d-inline-flex align-items-center gap-1" href="/auth/login">
                                <i class="bi bi-box-arrow-in-right"></i> Masuk (Login)
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-5 flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="footer-custom py-3 text-center small mt-auto">
        <div class="container">
            Bun Elysia HMVC Architecture &bull; Terinspirasi dari CodeIgniter 3
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>
