<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 — Halaman tidak ditemukan | Bun Elysia HMVC</title>
    <link rel="icon" href="/public/spark-admin/assets/images/favicon.ico">
    <link rel="stylesheet" href="/public/spark-admin/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/public/spark-admin/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/public/spark-admin/assets/css/main.css">
</head>
<body>
    <main class="login-wrapper">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>
        <section class="login-card text-center">
            <a href="/users" class="login-brand">
                <i class="bi bi-asterisk"></i>
                <span>Bun Elysia</span>
            </a>
            <div class="error-title-huge"><span>4</span><i class="bi bi-asterisk"></i><span>4</span></div>
            <h1 class="error-subtitle">Halaman tidak ditemukan</h1>
            <p class="error-desc">Halaman <code><%= requestedPath %></code> tidak tersedia atau alamatnya sudah berubah.</p>
            <div class="error-actions-group">
                <a href="/jobs" class="btn-custom btn-custom-primary"><i class="bi bi-briefcase"></i> Buka Lowongan</a>
                <a href="/users" class="btn-custom"><i class="bi bi-house"></i> Ke Dashboard</a>
            </div>
        </section>
    </main>
</body>
</html>
